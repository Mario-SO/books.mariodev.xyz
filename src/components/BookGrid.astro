---
import Book3D from './Book3D.astro';
import { getProgress } from '../lib/books';
import type { Book } from '../types/book';

interface Props {
	books: Book[];
	decorative?: boolean;
}

const { books, decorative = false } = Astro.props;
const statusLabel = (book: Book) => book.status === 'reading'
	? `Reading · ${getProgress(book)}%`
	: book.status === 'finished' ? 'Finished' : 'Unread';
---

<div class:list={['book-grid', { 'book-grid--decorative': decorative }]} aria-hidden={decorative ? 'true' : undefined} inert={decorative ? true : undefined}>
	{books.map((book, index) => (
		decorative ? (
			<div class="book-grid__item">
				<Book3D book={book} decorative />
			</div>
		) : (
			<a
				class="book-grid__item book-link"
				href={`/books/${book.slug}/`}
				aria-label={`Open ${book.title} by ${book.author}. ${statusLabel(book)}`}
				data-book-slug={book.slug}
				data-status={book.status}
				data-search={`${book.title} ${book.author}`}
			>
				<Book3D book={book} transitionName={`book-${book.slug}`} eager={index < 6} />
				<span class="book-status" aria-hidden="true">{statusLabel(book)}</span>
			</a>
		)
	))}
</div>

<style>
	.book-grid {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: clamp(38px, 5vw, 76px) clamp(28px, 4vw, 68px);
		width: min(1180px, 100%);
		margin: 0 auto;
		padding: clamp(54px, 8vh, 96px) clamp(26px, 5vw, 70px);
	}

	.book-grid__item {
		container-type: inline-size;
		display: grid;
		place-items: center;
		min-width: 0;
		text-decoration: none;
		outline: none;
	}

	.book-grid__item[hidden] { display: none; }
	.book-link { align-content: start; touch-action: manipulation; }
	.book-link:focus-visible { outline: 1px solid #464642; outline-offset: 6px; border-radius: 2px; }
	.book-status {
		margin-top: 8px;
		color: #6e6e69;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 11px;
		line-height: 1.5;
		font-variant-numeric: tabular-nums;
	}
	:global(book-shelf) .book-grid { padding-top: 28px; }

	.book-grid--decorative {
		width: min(1180px, 100%);
	}

	@media (min-width: 1360px) {
		.book-grid {
			grid-template-columns: repeat(6, minmax(0, 1fr));
			width: min(1330px, 100%);
			column-gap: clamp(34px, 3.2vw, 58px);
		}
		.book-grid--decorative { width: min(1330px, 100%); }
	}

	@media (max-width: 1023px) {
		.book-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 56px 28px;
			padding-inline: 24px;
		}
	}

	@media (max-width: 759px) {
		.book-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 60px 24px;
		}
	}

	@media (max-width: 519px) {
		.book-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 38px 16px;
			padding: 28px 20px 64px;
		}
	}
</style>
