---
import BookShelf from '../components/BookShelf.astro';
import Layout from '../layouts/Layout.astro';
import { books, usesPlaceholderData } from '../lib/books';
---

<Layout
	title="Reading — A personal book gallery"
	description="A quiet visual record of thirty books and their reading progress."
	noIndex={usesPlaceholderData}
	bodyClass="gallery-page"
>
	<a class="skip-link" href="#books">Skip to books</a>
	<main id="books" tabindex="-1" aria-label="Personal book gallery">
		<h1 class="sr-only">Reading — a personal book gallery</h1>
		<BookShelf books={books} />
	</main>
</Layout>

<style>
	main {
		min-height: 100vh;
		overflow: clip;
		background: #fff;
	}
</style>
