---
import BookGrid from '../components/BookGrid.astro';
import Layout from '../layouts/Layout.astro';
import { books, usesPlaceholderData } from '../lib/books';
---

<Layout
	title="Reading — A personal book gallery"
	description="A quiet visual record of thirty books and their reading progress."
	noIndex={usesPlaceholderData}
	bodyClass="gallery-page"
>
	<main aria-label="Personal book gallery">
		<BookGrid books={books} />
	</main>
</Layout>

<style>
	main {
		min-height: 100vh;
		overflow: clip;
		background: #fff;
	}
</style>
